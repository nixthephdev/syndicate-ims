# --- Syndicate IMS additions ---

# Nested node_modules (the client's Skateboard Studio demo ships its own).
# The default rule above is root-only.
node_modules/
.vscode/

# Client-supplied raw 3D assets. board.glb is 61.7 MB, wheels.glb is 74.6 MB —
# too heavy for git history AND far too heavy to serve to a shopper.
# See public/models/README.md. Compressed models WILL be committed.
*.glb
*.gltf

# The compressed, web-ready versions ARE the shippable asset and must be
# committed — without this negation the blanket rule above silently ate them
# too (caught before it ever reached production: `git status` showed nothing
# for public/models/ even after the compressed files existed on disk).
!/public/models/*.glb
!/public/models/*.gltf

# The group's capstone paper and other client documents. Not source code.
# Moved out of the web root. docs/ itself IS tracked — only docs/client/ isn't.
/docs/client
